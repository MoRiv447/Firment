diff --git a/test_todo.py b/test_todo.py
index 2414dcd..82c20aa 100644
--- a/test_todo.py
+++ b/test_todo.py
@@ -54,3 +54,23 @@ def test_save_load_roundtrip_unicode(tmp_path):
     assert tm2.tasks[0].title == "写周报"
     assert tm2.tasks[0].due == date(2026, 8, 7)
     assert tm2.tasks[1].done is True  # completion state must survive round-trip
+
+
+def test_rename_is_one_based():
+    tm = TaskManager()
+    tm.add("first")
+    tm.add("second")
+    tm.rename(1, "renamed")
+    assert tm.tasks[0].title == "renamed"
+    assert tm.tasks[1].title == "second"
+
+
+def test_rename_out_of_range():
+    tm = TaskManager()
+    tm.add("only")
+    try:
+        tm.rename(2, "nope")
+    except IndexError:
+        pass
+    else:
+        raise AssertionError("expected IndexError")
diff --git a/todo.py b/todo.py
index 97d4627..5bbc310 100644
--- a/todo.py
+++ b/todo.py
@@ -62,6 +62,15 @@ class TaskManager:
             raise IndexError(f"task {n} out of range")
         self.tasks[n].done = True
 
+    def rename(self, n, new_title):
+        """Rename the n-th task (1-based) to new_title.
+
+        Raises IndexError if n is out of range.
+        """
+        if n < 1 or n > len(self.tasks):
+            raise IndexError(f"task {n} out of range")
+        self.tasks[n - 1].title = new_title
+
     def list_tasks(self, include_done=False):
         if include_done:
             return list(self.tasks)
