+"""Project configuration.
+
+All settings are read from environment variables so that no secrets are
+committed to the repository. Copy ``.env.example`` to ``.env`` (or export
+the variables) to configure a real backend endpoint.
+
+Settings:
+- TODO_API_KEY   API key for the backend service (no default).
+- TODO_API_BASE  Base URL of the backend service.
+- TODO_DEBUG     Set to "1"/"true"/"yes"/"on" to enable debug logging.
+"""
+
+import os
+
+
+def _env_bool(name, default=False):
+    """Parse an environment variable as a boolean."""
+    raw = os.environ.get(name)
+    if raw is None:
+        return default
+    return raw.strip().lower() in {"1", "true", "yes", "on"}
+
+
+API_KEY = os.environ.get("TODO_API_KEY", "")
+API_BASE = os.environ.get("TODO_API_BASE", "https://api.example.com")
+DEBUG = _env_bool("TODO_DEBUG", False)
