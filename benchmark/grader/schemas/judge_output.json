{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI 评委输出契约",
  "type": "object",
  "required": ["case", "points", "self_report_used"],
  "additionalProperties": true,
  "properties": {
    "case": {"type": "string"},
    "self_report_used": {"type": "boolean"},
    "uncertain": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "score", "max", "confidence", "evidence", "reason"],
        "properties": {
          "id": {"type": "string"},
          "score": {"type": "number", "minimum": 0},
          "max": {"type": "number", "exclusiveMinimum": 0},
          "confidence": {"enum": ["high", "medium", "low"]},
          "verdict": {"type": "string"},
          "reason": {"type": "string"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "ref"],
              "properties": {
                "type": {"enum": ["code", "machine", "session", "frame", "la", "manual"]},
                "ref": {"type": "string"},
                "quote": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
