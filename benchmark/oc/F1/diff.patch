+        return {"title": self.title, "due": self.due.isoformat() if self.due else None, "done": self.done, "priority": self.priority}
 
     @classmethod
     def from_dict(cls, d):
         due = date.fromisoformat(d["due"]) if d.get("due") else None
-        return cls(d["title"], due=due, done=d.get("done", False))
+        return cls(d["title"], due=due, done=d.get("done", False), priority=d.get("priority", "medium"))
+
+
+PRIORITY_ORDER = {"high": 0, "medium": 1, "low": 2}
 
 
 def parse_due(value):
