[Unit]
Description=Firment SBC guard (collector + pre-filter + small-model classifier)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/sbc-guard
ExecStart=/usr/bin/python3 /home/radxa/sbc-guard/guardd.py /home/radxa/sbc-guard/config.toml
Restart=always
RestartSec=5
# Exit 2 is "the config file cannot be parsed". `Restart=always` would loop that every 5 s
# forever (the default start limit, 5 starts in 10 s, is never reached at that cadence), and
# every second of the loop is a second with no MQTT subscription — the whole point of this unit
# is to be subscribed. Let systemd record the failure instead so `systemctl status` shows it.
RestartPreventExitStatus=2
# Contain runaway sinks / ollama storms.
MemoryMax=256M
Nice=10

[Install]
WantedBy=multi-user.target
